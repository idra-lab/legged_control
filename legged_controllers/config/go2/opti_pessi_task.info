; Opti-Pessi MPC -- robot model, cost, limits, horizon and solver settings.
; Unitree Go2: opti_pessi_interface/config/task.info (Aliengo) with the Go2 geometry. Pass it to
; load_optipessicontroller_launch.xml as optipessiFile. Untuned: only comHeight, hipOffsets and footHipMax changed.
; Scenario-specific data (goal, obstacles, simulation) lives in opti_pessi_interface/config/scenario_S*.info.

model
{
  comHeight            0.30    ; h, locked CoM height [m] (legged_controllers/config/go2/reference.info comHeight)
  gravity              9.81    ; g [m/s^2]
  mass                 15.0    ; m [kg]; OptiPessiController replaces it with the URDF mass
  inertia              0.5     ; I about the vertical axis [kg m^2]; OptiPessiController replaces it with the URDF one
  frictionCoefficient  0.8     ; mu, rubber on asphalt
}

; Body-frame hip offsets [m], rows in the order FL, FR, RL, RR.
; Go2 URDF: x = leg_offset_x, y = leg_offset_y + thigh_offset = 0.142, scaled like the measured Aliengo y (0.134 of 0.1378).
hipOffsets
{
  (0,0)  0.1934   ; FL x
  (0,1)  0.138    ; FL y
  (1,0)  0.1934   ; FR x
  (1,1) -0.138    ; FR y
  (2,0) -0.1934   ; RL x
  (2,1)  0.138    ; RL y
  (3,0) -0.1934   ; RR x
  (3,1) -0.138    ; RR y
}

cost
{
  wc        2.5     ; CoM position error to the goal
  wdc       2.0     ; CoM velocity magnitude (regularization toward standstill)
  wp        0.5     ; foothold distance to the nominal hip
  wa        0.5     ; CoP centering, (alpha - 1/2)^2
  wdt       1e-2    ; contact-phase duration, (dt - dtCost0)^2
  wtheta    5.0    ; heading alignment
  wdtheta   2.0     ; yaw rate
}

limits
{
  alphaReduction  0.1    ; CoP margin: alpha in [eps, 1-eps], keeps both feet loaded
  dtMin           0.1    ; [s]
  dtMax           0.25   ; [s]
  dtCost0         0.25   ; preferred contact-phase duration [s]
  footHipMax      0.13   ; foot-to-hip reachability radius [m] (Aliengo 0.15, scaled by leg length 0.426/0.5)
  dcxMax          1.5    ; body-frame longitudinal speed [m/s]
  dcyMax          0.45   ; body-frame lateral speed [m/s]
  dthetaMax       0.8    ; yaw rate [rad/s]
}

; Keep-out model of each obstacle class a controller receives on its obstacle topic
; (type field of legged_controllers/msg/Obstacle.msg). Radius and maxSpeed are CppAD parameters,
; not compiled in: changing them needs no recompile. The scenario files keep their own
; obstacles.radius/maxSpeed for the standalone simulation.
obstacleTypes
{
  human
  {
    radius    0.2   ; r_obs [m]
    maxSpeed  1.0   ; v_obs [m/s], the bound the pessimistic branch is robust against
  }
  car
  {
    radius    2.4   ; [m], disk enclosing a 4.5 m x 1.8 m car about its centre
    maxSpeed  2.0   ; [m/s]
  }
}

horizon
{
  N  6   ; contact phases; with dt in [0.2, 0.35] s this is a 1.2-2.1 s lookahead
}

; Measured 10-dof robot state the simulation starts from:
; [cx, cy, theta, dcx, dcy, dtheta, p0x, p0y, p1x, p1y].
; The stance feet (last four) are overwritten at t=0 with the nominal FR/RL hip positions.
initialState
{
  (0,0)  -0.8   ; cx
  (1,0)  -0.5   ; cy
  (2,0)   0.0   ; theta
  (3,0)   0.0   ; dcx
  (4,0)   0.0   ; dcy
  (5,0)   0.0   ; dtheta
  (6,0)   0.0   ; p0x
  (7,0)   0.0   ; p0y
  (8,0)   0.0   ; p1x
  (9,0)   0.0   ; p1y
}

; Interior-point multiple shooting.
;
; dt = 1.0 and integratorType EULER are LOAD-BEARING, not tuning: OCS2 "time" is the knot index,
; and OptiPessiDynamicsAD::systemFlowMap returns lipMap(x,u) - x, so an Euler step of length 1
; reproduces the exact discrete LIP map. The real phase duration is the decision variable dt.
; See include/opti_pessi_interface/definitions.h.
ipm
{
  dt                             1.0
  integratorType                 EULER
  ipmIteration                   50
  deltaTol                       1e-4
  costTol                        1e-4
  g_min                          1e-4
  g_max                          1e6
  useFeedbackPolicy              false
  createValueFunction            false
  computeLagrangeMultipliers     false
  initialSlackLowerBound         1e-2
  initialBarrierParameter        1e-1
  targetBarrierParameter         1e-4
  nThreads                       1
  printSolverStatus              false
  printSolverStatistics          false
  printLinesearch                false
}

; Not read by ocs2::ipm::loadSettings; loaded separately by OptiPessiInterface.
; The hyperplane variables enter the collision rows bilinearly, so the QP Hessian is routinely
; singular and needs primal regularization.
hpipm
{
  reg_prim  1e2
}

mpc
{
  N                           6.0
  solutionTimeWindow          -1
  coldStart                    false
  debugPrint                   false
  mpcDesiredFrequency         50
  mrtDesiredFrequency         500
}

rollout
{
  AbsTolODE                    1e-5
  RelTolODE                    1e-3
  timeStep                     1.0
  integratorType               ODE45
  maxNumStepsPerSecond         10000
  checkNumericalStability      false
}
