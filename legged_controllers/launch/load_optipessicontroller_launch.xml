<?xml version="1.0" ?>
<launch>
  <arg name="robot_type" default="aliengo" description="Robot type: [a1, aliengo, go1, go2, laikago]"/>
  <arg name="joy"                 default="false" description="Enable joystick teleoperation"/>
  <arg name="rviz"                default="true"  description="Launch RViz2"/>
  <arg name="description_name"    default="legged_robot_description"/>
  <arg name="multiplot"           default="false"/>
  <!-- Opti-Pessi costs/constraints are CppAD libraries with task.info values compiled in: regenerate after editing it -->
  <arg name="recompile"           default="false" description="Regenerate the Opti-Pessi CppAD libraries from opti_pessi_interface/config/task.info"/>
  <arg name="phaseDiagnostics"    default="false" description="Log the per-phase lines (phase, diag, posture, wbc, touchdown, plan, obstacle)"/>
  <!-- obstacles.numSlots of this file is the number of obstacles the OCP keeps out at once -->
  <arg name="scenarioFile"        default="$(find-pkg-share opti_pessi_interface)/config/scenario_live.info" description="Opti-Pessi scenario file: obstacle slot count and goal tolerance"/>

  <!-- Model of the controller: the URDF of pinocchio (whole-body control, state estimator, and the LIP mass and yaw
       inertia of Opti-Pessi), generated here from these four, apart from the URDF of the world/hw launch. Pass that
       launch the same values for a model that matches the robot; different ones test a model error -->
  <arg name="camera"   default="true"  description="D435i (72 g) in the controller model"/>
  <arg name="lidar"    default="true"  description="RoboSense Airy (230 g) in the controller model; with slam_box:=true its mass is the box's"/>
  <arg name="nuc"      default="false" description="NUC on the front of the trunk in the controller model (legged_unitree_description urdf/common/nuc.xacro)"/>
  <arg name="slam_box" default="false" description="Slam box with the Airy on the back of the trunk in the controller model (urdf/common/slam_box.xacro)"/>

  <arg name="joy_dev" default="/dev/input/js0"/>
  <arg name="teleop_config" default="$(find-pkg-share legged_controllers)/config/joy.yaml"/>

  <!-- make the files into global parameters. The URDF is written before the spawners start (command substitution) -->
  <let name="urdfFile" value="$(command '$(find-pkg-prefix legged_common)/lib/legged_common/generate_urdf.sh $(find-pkg-share legged_unitree_description)/urdf/robot.xacro $(var robot_type) $(var camera) $(var lidar) $(var nuc) $(var slam_box) /tmp/legged_control/$(var robot_type)_controller.urdf' warn)"/>
  <let name="taskFile" value="$(find-pkg-share legged_controllers)/config/$(var robot_type)/task.info"/>
  <let name="referenceFile" value="$(find-pkg-share legged_controllers)/config/$(var robot_type)/reference.info"/>
  <!-- Opti-Pessi robot model: go2 has its own, the other robots use the Aliengo one -->
  <let name="optipessiFile" value="$(find-pkg-share opti_pessi_interface)/config/task.info"/>
  <let if="$(eval '\'$(var robot_type)\' == \'go2\'')" name="optipessiFile" value="$(find-pkg-share legged_controllers)/config/go2/opti_pessi_task.info"/>
  <let name="libraryFolder" value="$(find-pkg-share opti_pessi_interface)/lib"/>
  <let name="fallRecoveryFile" value="$(find-pkg-share legged_controllers)/config/$(var robot_type)/fall_recovery.info"/>

  <!-- Controller spawners (one per controller, as in load_controller.launch.py) -->
  <node pkg="controller_manager" exec="spawner" name="joint_state_broadcaster_spawner" output="screen"
    args="joint_state_broadcaster --controller-manager /controller_manager --service-call-timeout 120.0"/>

  <node pkg="controller_manager" exec="spawner" name="imu_sensor_broadcaster_spawner" output="screen"
    args="imu_sensor_broadcaster --controller-manager /controller_manager --service-call-timeout 120.0"/>

  <node pkg="controller_manager" exec="spawner" name="legged_controller_spawner" output="screen"
    args="legged_controller --controller-manager /controller_manager --service-call-timeout 120.0">
    <param name="urdfFile" value="$(var urdfFile)"/>
    <param name="taskFile" value="$(var taskFile)"/>
    <param name="referenceFile" value="$(var referenceFile)"/>
    <param name="optipessiFile" value="$(var optipessiFile)"/>
    <param name="scenarioFile" value="$(var scenarioFile)"/>
    <param name="libraryFolder" value="$(var libraryFolder)"/>
    <param name="recompile" value="$(var recompile)"/>
    <param name="phaseDiagnostics" value="$(var phaseDiagnostics)"/>
    <param name="fallRecoveryFile" value="$(var fallRecoveryFile)"/>
  </node>

  <!-- The goal comes on /opti_pessi/goal: no OCS2 gait command or target trajectories publisher (their legged_robot_*
       topics are not those of the controller). Of the joypad only the shutdown button (joy.yaml) acts here -->
  <node if="$(var joy)" pkg="legged_controllers" exec="kill_node_sigint_service.py" name="kill_node_sigint" output="screen">
    <param name="allow_kill" value="true"/>
  </node>

  <node if="$(var joy)" pkg="joy" exec="joy_node" name="joy_node" output="screen">
    <param name="dev" value="$(var joy_dev)"/>
    <param name="deadzone" value="1e-3"/>
    <param name="autorepeat_rate" value="10.0"/>
    <param name="coalesce_interval" value="0.05"/>
  </node>

  <node if="$(var joy)" pkg="joy_teleop" exec="joy_teleop" name="joy_teleop" output="screen">
    <param from="$(var teleop_config)"/>
  </node>

  <!-- rviz2 -->
  <group if="$(var rviz)">
    <arg name="rvizconfig" default="$(find-pkg-share legged_controllers)/config/config.rviz" />
    <node pkg="rviz2" exec="rviz2" name="rviz" args="-d $(var rvizconfig)" output="screen"/>
  </group>

  <!-- multiplot -->
  <group if="$(var multiplot)">
    <include file="$(find-pkg-share ocs2_legged_robot_ros)/launch/multiplot.launch.py"/>
  </group>
</launch>
