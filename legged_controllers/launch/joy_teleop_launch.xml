<?xml version="1.0" ?>

<launch>
  <let name="joy_dev" value="/dev/input/js0"/>
  <let name="teleop_config" value="$(find-pkg-share legged_controllers)/config/joy.yaml"/>

  <node pkg="joy" exec="joy_node" name="joy_node">
    <param name="dev" value="$(var joy_dev)"/>
    <param name="deadzone" value="1e-3"/>
    <param name="autorepeat_rate" value="10"/>
    <param name="coalesce_interval" value="0.05"/>
  </node>

  <node pkg="joy_teleop" exec="joy_teleop.py" name="joy_teleop">
    <param from="$(var teleop_config)"/>
  </node>
</launch>