<?xml version="1.0" ?>

<launch>
    <arg name="robot_type" default="aliengo" doc="Robot type: [a1, aliengo, go1, laikago]"/>
    <arg name="joy" default="false" />
    <arg name="rviz"               default="true" />
    <arg name="description_name"   default="legged_robot_description"/>
    <arg name="multiplot"          default="false"/>

    <arg name="joy_dev" default="/dev/input/js0"/>
    <arg name="teleop_config" default="$(find legged_controllers)/config/joy.yaml"/>

    <arg name="nn" default="false"/>
    <arg name="mps" default="false"/>
    <arg name="joy_msg" default="false"/>
    <arg name="only_rl" default="false"/>
    <arg name="only_mpc" default="false"/>
    


    <!-- make the files into global parameters -->
    <param name="urdfFile" value="/tmp/legged_control/$(arg robot_type).urdf"/>
    <param name="taskFile" value="$(find legged_controllers)/config/$(arg robot_type)/task.info"/>
    <param name="referenceFile" value="$(find legged_controllers)/config/$(arg robot_type)/reference.info"/>
    <param name="gaitCommandFile" value="$(find legged_controllers)/config/$(arg robot_type)/gait.info"/>
    <param name="useNN" value="$(arg nn)"/>
    <param name="onlyRL" value="$(arg only_rl)"/>
    <param name="onlyMPC" value="$(arg only_mpc)"/>

    <rosparam file="$(find legged_controllers)/config/controllers.yaml" command="load"/>

    <group unless="$(arg mps)">
      <node name="controller_loader" pkg="controller_manager" type="spawner"
          output="screen" args="controllers/joint_state_controller
	    controllers/legged_controller
	    controllers/imu_sensor_controller"/>
    </group>
    <group if="$(arg mps)">
      <node name="controller_loader" pkg="controller_manager" type="spawner"
          output="screen" args="controllers/joint_state_controller
	    controllers/mps_controller
	    controllers/imu_sensor_controller"/>
    </group>
    
    <group unless="$(arg joy_msg)">
      <!-- If not using the joypad, keep using the old keyboard based program to select the gaits -->
      <node unless="$(arg joy)" pkg="ocs2_legged_robot_ros" type="legged_robot_gait_command" name="legged_robot_gait_command"
            output="screen"/>

      <!-- If using the joypad, run a command that accepts joystick commands to switch between stance and trot gaits with a button press -->
      <node if="$(arg joy)" pkg="ocs2_legged_robot_ros" type="legged_robot_gait_joy_command" name="legged_robot_gait_joy_command"
            output="screen"/>


      <node if="$(arg joy)" pkg="legged_controllers" type="kill_node_sigint_service.py" name="kill_node_sigint" output="screen">
        <param name="allow_kill" value="true"/>
      </node>

      <node if="$(arg joy)" pkg="joy" type="joy_node" name="joy_node">
          <param name="dev" value="$(arg joy_dev)"/>
          <param name="deadzone" value="1e-3"/>
          <param name="autorepeat_rate" value="10"/>
          <param name="coalesce_interval" value="0.05"/>
      </node>

      <rosparam file="$(arg teleop_config)" command="load"/>
      <node if="$(arg joy)" pkg="joy_teleop" type="joy_teleop.py" name="joy_teleop">
      </node>
    </group>

    <group if="$(arg joy_msg)">
      
      <!-- If using the joypad, run a command that accepts joystick commands to switch between stance and trot gaits with a button press -->
      <node if="$(arg joy_msg)" pkg="ocs2_legged_robot_ros" type="legged_robot_gait_joy_command" name="legged_robot_gait_joy_command"
            output="screen"/>

    </group>

    <node pkg="legged_controllers" type="legged_target_trajectories_publisher" name="legged_robot_target"
        output="screen"/>

              <!-- rviz -->
    <group if="$(arg rviz)">
      <arg name="rvizconfig" default="$(find legged_controllers)/config/config.rviz" />
      <node pkg="rviz" type="rviz" name="rviz" args="-d $(arg rvizconfig)"/>
    </group>
    <!--node pkg="rosservice" type="rosservice" name="chg_ctrl" args="call /controller_manager/switch_controller &quot;{start_controllers: ['controllers/legged_controller', 'controllers/joint_state_controller', 'controllers/imu_sensor_controller'], 
    stop_controllers: [''], strictness: 0, start_asap: false,
	    timeout: 0.0}&quot;" /-->   
	

    <!-- multiplot -->
    <group if="$(arg multiplot)">
      <include file="$(find ocs2_legged_robot_ros)/launch/multiplot.launch"/>
    </group>
</launch>
