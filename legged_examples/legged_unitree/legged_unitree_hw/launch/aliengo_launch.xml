<launch>
  <arg name="robot_type" default="$(env ROBOT_TYPE)"/>

  <!-- controller_manager with the hardware plugin of the URDF (it reads /robot_description of robot_state_publisher):
       the controllers of the simulation, then the overrides of the real robot -->
  <node pkg="controller_manager" exec="ros2_control_node" output="screen">
    <param from="$(find-pkg-share legged_controllers)/config/controllers.yaml"/>
    <param from="$(find-pkg-share legged_unitree_hw)/config/$(var robot_type).yaml"/>
  </node>
</launch>
