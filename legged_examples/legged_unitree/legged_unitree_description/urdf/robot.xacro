<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <xacro:arg name="robot_type" default="a1"/>
    <xacro:arg name="camera" default="true"/>
    <xacro:arg name="lidar" default="true"/>

    <xacro:include filename="$(find legged_unitree_description)/urdf/common/materials.xacro"/>
    <xacro:include filename="$(find legged_unitree_description)/urdf/common/leg.xacro"/>
    <xacro:include filename="$(find legged_unitree_description)/urdf/common/gazebo.xacro"/>
    <xacro:include filename="$(find legged_unitree_description)/urdf/common/imu.xacro"/>
    <xacro:include filename="$(find legged_unitree_description)/urdf/common/d435i.xacro"/>
    <xacro:include filename="$(find legged_unitree_description)/urdf/common/robosense_airy.xacro"/>

    <xacro:include filename="$(find legged_unitree_description)/urdf/$(arg robot_type)/const.xacro"/>

   <!--    <xacro:property name="mesh_path" value="../meshes"/>-->
   <!-- Meshes are in legged_unitree_description/meshes/{robot_type}/, NOT in a
        separate {robot_type}_description package (which does not exist here). -->
   <xacro:property name="mesh_path" value="package://legged_unitree_description/meshes/$(arg robot_type)"/>

    <link name="base"/>
    <joint name="base_inertia_joint" type="fixed">
      <parent link="base"/>
      <child link="base_inertia" />
    </joint>

    <link name="base_inertia">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_path}/trunk.dae" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="${trunk_length} ${trunk_width} ${trunk_height}"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="${trunk_com_x} ${trunk_com_y} ${trunk_com_z}"/>
            <mass value="${trunk_mass}"/>
            <inertia
                    ixx="${trunk_ixx}" ixy="${trunk_ixy}" ixz="${trunk_ixz}"
                    iyy="${trunk_iyy}" iyz="${trunk_iyz}"
                    izz="${trunk_izz}"/>
        </inertial>
    </link>

    <xacro:IMU connected_to="base" imu_name="base_imu" xyz="0. 0. 0." rpy="0. 0. 0."/>

    <!-- Front-mounted Intel RealSense D435i, pitched 20 deg down to see the terrain ahead -->
    <xacro:if value="$(arg camera)">
        <xacro:D435i name="camera" parent="base" xyz="${trunk_length/2 + 0.03} 0 0" rpy="0 ${5*pi/180} 0"/>
    </xacro:if>

    <!-- RoboSense Airy on top of the trunk, 4 cm behind the front edge on a 1 cm riser, pitched 15 deg forward.
         Its dome only covers 0-90 deg above its base plane: upright it would see nothing below its own height
         (no ground, no low obstacles for terrainAnalysis). Pitched, the front of the dome dips 15 deg below the
         horizon and sees the ground from ~1.9 m ahead. 15 deg, not more, keeps people and forklifts visible all
         round for detection: behind the robot the dome starts 15 deg above the horizon (0.5 m + 0.27 m per meter
         of distance), so heads stay in view to ~4 m and a forklift mast to ~6 m.
         Mount-dependent: FAST-LIO imu_R/extrinsic_R and the static TFs of fast_lio_slam_launch.xml. -->
    <xacro:if value="$(arg lidar)">
        <xacro:RobosenseAiry name="rslidar" parent="base" xyz="${trunk_length/2 - 0.04} 0 ${trunk_height/2 + 0.01}" rpy="0 ${15*pi/180} 0"/>
    </xacro:if>


    <xacro:leg prefix="LF" mesh_path="${mesh_path}" mirror="1" mirror_dae="True" front_hind="1" front_hind_dae="True">
        <origin rpy="0 0 0" xyz="${leg_offset_x} ${leg_offset_y} 0"/>
    </xacro:leg>

    <xacro:leg prefix="LH" mesh_path="${mesh_path}" mirror="1" mirror_dae="True" front_hind="-1" front_hind_dae="False">
        <origin rpy="0 0 0" xyz="${-leg_offset_x} ${leg_offset_y} 0"/>
    </xacro:leg>

    <xacro:leg prefix="RF" mesh_path="${mesh_path}" mirror="-1" mirror_dae="False" front_hind="1" front_hind_dae="True">
        <origin rpy="0 0 0" xyz="${leg_offset_x} ${-leg_offset_y} 0"/>
    </xacro:leg>

    <xacro:leg prefix="RH" mesh_path="${mesh_path}" mirror="-1" mirror_dae="False" front_hind="-1" front_hind_dae="False">
        <origin rpy="0 0 0" xyz="${-leg_offset_x} ${-leg_offset_y} 0"/>
    </xacro:leg>

</robot>
