<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="sim" default="true"/>

    <!-- Real robot only (sim:=false): Unitree SDK of the hardware plugin (3_8_0 or 3_3_1) and the parameters UnitreeHW reads; legged_unitree_hw_launch.xml passes them -->
    <xacro:arg name="unitree_sdk" default="3_3_1"/>
    <xacro:arg name="robot_ip" default="192.168.123.10"/>
    <xacro:arg name="power_limit" default="7"/>
    <xacro:arg name="contact_threshold" default="40"/>

    <!-- ===================================================================
         ros2_control configuration
         Only joints are declared here. Sensors (IMU, contacts) are handled
         internally by LeggedHWSim::initSim() and read() — they cannot be
         declared here because export_state_interfaces() is called during
         on_configure() BEFORE initSim() populates the sensor data structures,
         which would cause a resource_manager mismatch and SIGSEGV.
    =================================================================== -->
    <ros2_control name="LeggedRobot" type="system">
        <hardware>
            <xacro:if value="$(arg sim)">
                <plugin>legged_gazebo/LeggedHWSim</plugin>
            </xacro:if>
            <xacro:unless value="$(arg sim)">
                <plugin>legged_hw/LeggedHW</plugin>
                <!-- UnitreeHW exports the foot contacts (RF_FOOT/contact, ...) itself, undeclared as in Gazebo -->
                <plugin>legged_unitree_hw/UnitreeHW_$(arg unitree_sdk)</plugin>
                <param name="robot_type">$(arg robot_type)</param>
                <param name="robot_ip">$(arg robot_ip)</param>
                <param name="power_limit">$(arg power_limit)</param>
                <param name="contact_threshold">$(arg contact_threshold)</param>
            </xacro:unless>
        </hardware>

        <xacro:macro name="legged_joint" params="name">
            <joint name="${name}">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="kp"/>
                <command_interface name="kd"/>
                <command_interface name="effort"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
        </xacro:macro>

        <!-- LF leg -->
        <xacro:legged_joint name="LF_HAA"/>
        <xacro:legged_joint name="LF_HFE"/>
        <xacro:legged_joint name="LF_KFE"/>

        <!-- LH leg -->
        <xacro:legged_joint name="LH_HAA"/>
        <xacro:legged_joint name="LH_HFE"/>
        <xacro:legged_joint name="LH_KFE"/>

        <!-- RF leg -->
        <xacro:legged_joint name="RF_HAA"/>
        <xacro:legged_joint name="RF_HFE"/>
        <xacro:legged_joint name="RF_KFE"/>

        <!-- RH leg -->
        <xacro:legged_joint name="RH_HAA"/>
        <xacro:legged_joint name="RH_HFE"/>
        <xacro:legged_joint name="RH_KFE"/>

        <!-- IMU sensor declaration.
             initSim() runs BEFORE export_state_interfaces() in gazebo_ros2_control,
             so imuDatas_ is already populated when the resource_manager claims these
             interfaces. Without this block, imu_sensor_broadcaster has no state
             interfaces to read and publishes all zeros. -->
        <sensor name="base_imu">
            <state_interface name="orientation.x"/>
            <state_interface name="orientation.y"/>
            <state_interface name="orientation.z"/>
            <state_interface name="orientation.w"/>
            <state_interface name="angular_velocity.x"/>
            <state_interface name="angular_velocity.y"/>
            <state_interface name="angular_velocity.z"/>
            <state_interface name="linear_acceleration.x"/>
            <state_interface name="linear_acceleration.y"/>
            <state_interface name="linear_acceleration.z"/>
        </sensor>
    </ros2_control>

    <!-- ===================================================================
         gz_ros2_control plugin (Gazebo Harmonic)
    =================================================================== -->
    <xacro:arg name="controllers_yaml" default="$(find legged_controllers)/config/controllers.yaml"/>

    <gazebo>
        <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
            <parameters>$(arg controllers_yaml)</parameters>
        </plugin>
    </gazebo>

    <!-- ===================================================================
         p3d ground-truth odometry plugin — DISABLED
         Throws C++ exception during Load() with Gazebo 11 / ROS 2 Humble
         when using <ros><namespace> syntax. Not required for simulation.
    =================================================================== -->
    <!--
    <gazebo>
        <plugin name="p3d_base_controller" filename="libgazebo_ros_p3d.so">
            <ros>
                <remapping>odom:=ground_truth/state</remapping>
            </ros>
            <body_name>base_inertia</body_name>
            <frame_name>world</frame_name>
            <update_rate>500.0</update_rate>
            <xyz_offset>0 0 0</xyz_offset>
            <rpy_offset>0 0 0</rpy_offset>
            <gaussian_noise>0.0</gaussian_noise>
        </plugin>
    </gazebo>
    -->

</robot>
