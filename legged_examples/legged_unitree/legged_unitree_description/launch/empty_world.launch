<launch>
    <arg name="robot_type" default="aliengo" doc="Robot type: [a1, aliengo, go1, laikago]"/>
    <arg name="gz_gui" default="true"/>

    <param name="legged_robot_description" command="$(find xacro)/xacro $(find legged_unitree_description)/urdf/robot.xacro
       robot_type:=$(arg robot_type)
    "/>
    <node name="generate_urdf" pkg="legged_common" type="generate_urdf.sh" output="screen"
          args="$(find legged_unitree_description)/urdf/robot.xacro $(arg robot_type)"/>

    <rosparam file="$(find legged_gazebo)/config/default.yaml" command="load"/>
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="gui" value="$(arg gz_gui)"/>
        <arg name="world_name" value="$(find legged_gazebo)/worlds/empty_world.world"/>
        <arg name="paused" value="true"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="extra_gazebo_args" value="--seed 1"/>
    </include>
    <!-- push robot_description to factory and spawn robot in gazebo -->
    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" clear_params="true"
          args="-z 0.5 -param legged_robot_description -urdf -model  $(arg robot_type) -unpause" output="screen"/>

    <!--node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" clear_params="true"
          args="-z 0.44 -param legged_robot_description -urdf -model $(arg robot_type)
          -J LF_HAA -0.1 -J LF_HFE 0.62 -J LF_KFE -1.24 
          -J LH_HAA -0.1 -J LH_HFE 0.62 -J LH_KFE -1.24 
          -J RF_HAA  0.1 -J RF_HFE 0.62 -J RF_KFE -1.24 
          -J RH_HAA  0.1 -J RH_HFE 0.62 -J RH_KFE -1.24 -unpause " respawn="false" output="screen" /-->

</launch>
