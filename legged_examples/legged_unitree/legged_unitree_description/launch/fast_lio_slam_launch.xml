<launch>
  <!-- FAST-LIO + SC-PGO (src/FAST_LIO_SLAM_ROS2) on the simulated Unitree L2 (lidar:=true in the world launch).
       Start it once the robot stands still: FAST-LIO takes gravity and camera_init from the first IMU samples.
       TF:  lio_map -> camera_init -> unilidar_lio -> lio_base   (FAST-LIO, config/fast_lio_unitree_l2.yaml)
                       camera_init -> aft_pgo                    (SC-PGO, loop-closed unilidar_lio)
       lio_map is the base frame when FAST-LIO started, lio_base the base pose FAST-LIO estimates.
       Both offsets are the unilidar_lidar_joint xyz in robot.xacro; the rotation is in imu_R/extrinsic_R. -->
  <arg name="use_sim_time" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="pgo" default="true" description="Run SC-PGO loop closure (needs sc_pgo_ros2 built)"/>
  <arg name="save_directory" default="$(env HOME)/.ros/sc_pgo/" description="SC-PGO poses and keyframes; its Scans/ subfolder is wiped on start"/>

  <node pkg="fast_lio" exec="fastlio_mapping" name="laser_mapping" output="screen">
    <param from="$(find-pkg-share legged_gazebo)/config/fast_lio_unitree_l2.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="tf2_ros" exec="static_transform_publisher" name="lio_map_to_camera_init"
    args="--x 0.2935 --z -0.076 --frame-id lio_map --child-frame-id camera_init"/>
  <node pkg="tf2_ros" exec="static_transform_publisher" name="unilidar_lio_to_lio_base"
    args="--x -0.2935 --z 0.076 --frame-id unilidar_lio --child-frame-id lio_base"/>

  <node if="$(var pgo)" pkg="sc_pgo_ros2" exec="alaserPGO" name="alaserPGO" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="save_directory" value="$(var save_directory)"/>
    <param name="keyframe_meter_gap" value="1.0"/>
    <param name="keyframe_deg_gap" value="10.0"/>
    <param name="sc_dist_thres" value="0.3"/>
    <param name="sc_max_radius" value="20.0"/>   <!-- indoor; L2 range is 30 m -->
    <param name="mapviz_filter_size" value="0.1"/>
    <remap from="/aft_mapped_to_init" to="/Odometry"/>
    <remap from="/velodyne_cloud_registered_local" to="/cloud_registered_body"/>
  </node>

  <node if="$(var rviz)" pkg="rviz2" exec="rviz2" name="fast_lio_rviz"
    args="-d $(find-pkg-share fast_lio)/rviz/fastlio.rviz">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
