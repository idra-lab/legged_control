<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>opti_pessi_perception</name>
  <version>0.0.0</version>
  <description>
    YOLO26 detection on RGB + per-object 3D point from registered depth, run with YOLOs-CPP (ONNX Runtime).
    Publishes the persons and forklifts it sees as legged_controllers/ObstacleArray in odom, the obstacles
    the Opti-Pessi controller keeps out of. C++ port of yolo/yolo26_rgbd_detect.py.
  </description>
  <maintainer email="alejandro.enrique.barbi@gmail.com">abarbi</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>legged_controllers</depend>
  <depend>libopencv-dev</depend>
  <!-- YOLOs-CPP (header-only) and ONNX Runtime have no rosdep key: they come from src/YOLOs-CPP, see CMakeLists.txt. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
